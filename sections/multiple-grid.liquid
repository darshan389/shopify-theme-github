{% schema %}
{
  "name": "Multiple Grid",
  "settings": [],
  "blocks": [
    {
      "name": "One-item",
      "type": "grid",
      "settings": [
        {
          "type": "select",
          "id": "block__width_select",
          "label": "Block Width Select",
          "options": [
            {
              "label": "Full Size",
              "value": "full_size"
            },
            {
              "label": "Medium Size",
              "value": "medium_size "
            },
            {
              "label": "Small Size",
              "value": "small_size"
            }
          ]
        },
        {
          "type": "select",
          "id": "block_type_select",
          "label": "Block Type Select",
          "options": [
            {
              "label": "Text & Button",
              "value": "text_button"
            },
            {
              "label": "Only Text",
              "value": "only_text"
            },
            {
              "label": "Text & icon",
              "value": "text_icon"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "block_title",
          "label": "Title",
          "visible_if": "{{ block.settings.block_type_select != 'only_text' }}"
        },
        {
          "type": "text",
          "id": "block_text",
          "label": "Text",
          "visible_if": "{{ block.settings.block_type_select != 'only_text' }}"
        },
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Image",
          "visible_if": "{{ block.settings.block_type_select == 'text_icon' }}"
        },
        {
          "type": "text",
          "id": "block_btn_text",
          "label": "Button Text",
          "visible_if": "{{ block.settings.block_type_select == 'text_button' }}"
        },
        {
          "type": "url",
          "id": "block_btn_url",
          "label": "Button Url",
          "visible_if": "{{ block.settings.block_type_select == 'text_button' }}"

        },
        {
          "type": "select",
          "id": "block_btn_icon",
          "label": "Button Icon",
          "options": [
            {
              "label": "Right Arrow",
              "value": "right_arrow",
            },
            {
              "label": "Left Arrow",
              "value": "left_arrow",
            },
            {
              "label": "None",
              "value": "none"
            }
          ],
          "visible_if": "{{ block.settings.block_type_select == 'text_button' }}"
        },
        {
          "type": "header",
          "content": "Label 1",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "inline_richtext",
          "id": "only_text_title1",
          "label": "Title",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "richtext",
          "id": "only_text_dec1",
          "label": "Text",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "header",
          "content": "Label 2",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "inline_richtext",
          "id": "only_text_title2",
          "label": "Title",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "richtext",
          "id": "only_text_dec2",
          "label": "Text",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "header",
          "content": "Label 3",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "inline_richtext",
          "id": "only_text_title3",
          "label": "Title",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "richtext",
          "id": "only_text_dec3",
          "label": "Text",
          "visible_if": "{{ block.settings.block_type_select == 'only_text' }}"
        },
        {
          "type": "color",
          "id": "block_bgcolor",
          "label": "Background"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multiple Grid"
    }
  ]
}
{% endschema %}
