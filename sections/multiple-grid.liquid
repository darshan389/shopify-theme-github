<div class="wrapper">
  <section class="color-grid">
    <div class="container">
      <div class="color-grid-flex">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'grid' %}
              <div
                class="{% if block.settings.block__width_select == "full_size" %}c-grid-1{% elsif block.settings.block__width_select == "medium_size" %} c-grid-4{% else %} c-grid-2{% endif %}"
                style="background:{{ block.settings.block_bgcolor }}" {{ block.shopify_attributes }}
              >                
                {% if block.settings.block_type_select == 'text_button' %}
                  <div class="contetnt-inner">
                    <h1>{{ block.settings.block_title }}</h1>
                    <p>
                      {{ block.settings.block_text }}
                    </p>
                    <a href="{{ block.settings.block_btn_url }}" class="btn-bg-border">
                      <span>{{ block.settings.block_btn_text }}</span>
                      {% render 'icons', icon: 'right_arrow' %}
                    </a>
                  </div>
                {% elsif block.settings.block_type_select == 'only_text' %}
                  <div class="content-grid-2">
                    <div class="h1">{{ block.settings.only_text_title1 }}</div>
                    {{ block.settings.only_text_dec1 }}
                  </div>
                  <div class="content-grid-2">
                    <div class="h1">{{ block.settings.only_text_title2 }}</div>
                    {{ block.settings.only_text_dec2 }}
                  </div>
                  <div class="content-grid-2">
                    <div class="h1">{{ block.settings.only_text_title3 }}</div>
                    {{ block.settings.only_text_dec3 }}
                  </div>
                {% else %}
                  <div class="smile-content">
                    <img src="{{ block.settings.block_image | image_url }}" width="40" height="40" style="margin: 0 auto;">
                    <p class="title sh1">{{ block.settings.block_title }}</p>
                    <p class="h4">
                      {{ block.settings.block_text }}
                    </p>
                  </div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
        {% comment %} 
          <div class="c-grid-2" style="background:#EBC9BD"></div>
          <div class="c-grid-3">
